# ===============================================
# Campus Placement Management System - Environment Variables
# ===============================================

# Port number on which the Express server will listen
PORT=5000

# Database Configuration (for Phase 2 and beyond)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campus_placement_db
DB_PORT=3306

# JWT Authentication Secret Key (for Phase 2 and beyond)
JWT_SECRET=super_secret_placement_key_12345
